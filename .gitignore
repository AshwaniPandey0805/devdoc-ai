# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build Outputs & Compiled Code
dist/
backend/dist/
frontend/dist/

# User Uploaded Documents (Preserve folder, ignore uploaded files)
backend/uploads/*
!backend/uploads/.gitkeep

# Environment Variables & Secrets (Keep .env.example, ignore real credentials)
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.env
!*.env.example
!backend/.env.example
!frontend/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS & Editor Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# TypeScript / Vite Caches
*.tsbuildinfo
.vite/