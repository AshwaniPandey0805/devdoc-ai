# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/devdocs-ai

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# --- Added in later stages, not needed yet ---
JWT_SECRET=dadsadsadsadasdjhvfddshvydfcydsfcyafdcytdft
FIREBASE_PROJECT_ID=devdoc-ai-c4dcd
# Single-line JSON representation of your Firebase Service Account Private Key:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"devdoc-ai-c4dcd",...}

# AWS S3 Cloud Storage (Stage 3 - Optional; defaults to local uploads/ if not configured)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Vector Embeddings (Stage 4 - OpenAI text-embedding-3 / Hugging Face local fallback)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: Matryoshka Representation Learning dimension reduction (e.g. 512, 1536)
OPENAI_EMBEDDING_DIMENSIONS=1536

# REDIS_URL=